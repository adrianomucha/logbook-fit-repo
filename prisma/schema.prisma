// prisma/schema.prisma
// LogBook.fit — Database Schema
// Source: logbook_db_backend_v3_FINAL.md §2.1

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────
// ENUMS
// ──────────────────────────────────────

enum UserRole {
  COACH
  CLIENT
}

enum WorkoutStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum CheckInStatus {
  PENDING
  CLIENT_RESPONDED
  COMPLETED
  // A PENDING check-in the client never answered, closed out after two full
  // cadences so it stops blocking the weekly schedule. Hidden from history.
  EXPIRED
}

enum EffortRating {
  EASY
  MEDIUM
  HARD
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum WaitlistStatus {
  PENDING
  INVITED
  JOINED
}

enum FeedbackCategory {
  BUG
  IDEA
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  RESOLVED
}

// How an exercise is measured. When TIME, the reps-shaped integer columns
// (Exercise.defaultReps, WorkoutExercise.reps/repsMax, SetCompletion.actualReps)
// hold a duration in seconds instead of a rep count.
enum TrackingType {
  REPS
  TIME
}

// Which transport delivers to a PushSubscription row.
//   WEB  — browser Web Push: `endpoint` is the push-service URL, keys present
//   EXPO — native app via Expo's push service: `endpoint` holds the Expo push
//          token ("ExponentPushToken[…]"), no keys
enum PushProvider {
  WEB
  EXPO
}

enum ExerciseCategory {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  GLUTES
  CORE
  CARDIO
  FULL_BODY
  OTHER
}

// ──────────────────────────────────────
// AUTH & USERS
// ──────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    // Uniqueness enforced via partial index (see migrations)
  passwordHash String
  name         String
  role         UserRole
  avatarUrl    String?
  timezone     String    @default("UTC")
  // Owner-managed pairing with this person's other account (coach ↔ client),
  // stored symmetrically on both rows. Powers the nav's one-click account
  // switch. Written only by the owner (SQL/admin) — no user-facing API sets it.
  linkedUserId String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Role-specific profiles
  coachProfile  CoachProfile?
  clientProfile ClientProfile?

  // Messages (both roles send and receive)
  sentMessages     Message[] @relation("sender")
  receivedMessages Message[] @relation("recipient")

  // Web Push endpoints — one row per browser/device that opted in
  pushSubscriptions PushSubscription[]

  // Product feedback submitted from the in-app dialog
  feedback Feedback[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model CoachProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Owned resources
  exercises Exercise[]
  plans     Plan[]
  clients   CoachClientRelationship[]
  invites   ClientInvite[]
  checkIns  CheckIn[]

  @@map("coach_profiles")
}

model ClientProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  activePlanId  String?
  planStartDate DateTime?
  // Coach-created demo client for exploring the product before real clients
  // join; surfaced with a badge and removable in one action
  isSample      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  activePlan Plan? @relation("activePlan", fields: [activePlanId], references: [id])

  // Relationships
  coachRelationship CoachClientRelationship?
  completions       WorkoutCompletion[]
  checkIns          CheckIn[]

  @@index([activePlanId])
  @@map("client_profiles")
}

// ──────────────────────────────────────
// COACH-CLIENT RELATIONSHIP
// ──────────────────────────────────────

model CoachClientRelationship {
  id        String       @id @default(uuid())
  coachId   String
  clientId  String       @unique // MVP: one coach per client
  status    ClientStatus @default(ACTIVE)
  // Check-in automation: when enabled, a new check-in is created once the
  // cadence elapses since the last one — by the nightly cron sweep
  // (/api/cron/check-ins), and opportunistically when either party loads
  // check-in data. On by default: coaches assume weekly check-ins simply
  // happen, and a default-off retention loop buried in a third-level tab is
  // one nobody turns on. The coach can still switch it off per client.
  checkInScheduleEnabled Boolean @default(true)
  // Cadence of the auto check-in: a new one is due this many days after the
  // last. Coach-configurable per client (3, 7, 14 or 28 in the UI).
  checkInIntervalDays Int @default(7)
  // Optional anchor weekday for the cadence, 0 = Sunday … 6 = Saturday,
  // evaluated in the client's timezone (User.timezone; UTC when unknown).
  // Null = send whenever the interval elapses. Ignored for intervals shorter
  // than a week.
  checkInDayOfWeek Int?
  // Termination audit: set when the coach ends the relationship or the
  // client unsubscribes. status becomes INACTIVE; the row is kept as history.
  endedAt   DateTime?
  endedBy   UserRole?
  // Plan assignment at the moment the relationship ended — lets Restore put
  // the client back exactly where they left off. No FK: the plan may be
  // deleted while the relationship sits in the archive.
  endedPlanId        String?
  endedPlanStartDate DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  coach  CoachProfile  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([coachId, clientId])
  @@index([coachId])
  @@index([clientId])
  @@map("coach_client_relationships")
}

model ClientInvite {
  id        String       @id @default(uuid())
  coachId   String
  token     String       @unique
  email     String?
  // Personal note from the coach, shown on the invite landing page and
  // delivered as the coach's first chat message when the client signs up
  note      String?
  status    InviteStatus @default(PENDING)
  expiresAt DateTime     // 7 days from creation
  createdAt DateTime     @default(now())

  coach CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([coachId])
  @@map("client_invites")
}

// ──────────────────────────────────────
// EXERCISE LIBRARY
// ──────────────────────────────────────

model Exercise {
  id            String           @id @default(uuid())
  coachId       String
  name          String
  category      ExerciseCategory @default(OTHER)
  trackingType  TrackingType     @default(REPS)
  defaultSets   Int?             @default(3)
  defaultReps   Int?             @default(10) // Seconds when trackingType = TIME
  defaultWeight Float?
  defaultRest   Int?             // seconds
  instructions  String?          // Coach's cue notes
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  coach            CoachProfile    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  // Uniqueness enforced via partial index (see migrations)
  @@index([coachId])
  @@index([coachId, category])
  @@map("exercises")
}

// ──────────────────────────────────────
// PLAN STRUCTURE
// ──────────────────────────────────────

model Plan {
  id              String    @id @default(uuid())
  coachId         String
  name            String
  description     String?
  emoji           String    @default("💪")
  durationWeeks   Int       @default(4)
  workoutsPerWeek Int       @default(4)
  // Template/instance split: null = coach-authored template (the Plans page).
  // Set = a client's own copy created at assignment, pointing at the root
  // template it was cloned from. No FK — templates are deletable while
  // clients keep training on their copies.
  sourceTemplateId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  editedAt        DateTime? // Last mid-cycle edit timestamp
  deletedAt       DateTime?

  coach       CoachProfile    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  weeks       Week[]
  assignedTo  ClientProfile[] @relation("activePlan")
  completions WorkoutCompletion[]

  @@index([coachId])
  @@index([sourceTemplateId])
  @@map("plans")
}

model Week {
  id         String   @id @default(uuid())
  planId     String
  weekNumber Int      // 1-indexed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  plan Plan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  days Day[]

  @@unique([planId, weekNumber])
  @@index([planId])
  @@map("weeks")
}

model Day {
  id          String  @id @default(uuid())
  weekId      String
  orderIndex  Int     // Sequential: 1, 2, 3... (workout days only, no rest days)
  name        String? // e.g., "Upper Body Push"
  description String? // Coach's workout briefing shown to client before starting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  week        Week              @relation(fields: [weekId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]
  completions WorkoutCompletion[]

  @@unique([weekId, orderIndex])
  @@index([weekId])
  @@map("days")
}

// ──────────────────────────────────────
// WORKOUT EXERCISES (Join table with data)
// ──────────────────────────────────────

model WorkoutExercise {
  id          String  @id @default(uuid())
  dayId       String
  exerciseId  String
  orderIndex  Int     // Sort order within the day — unique per day
  trackingType TrackingType @default(REPS) // When TIME, reps/repsMax hold seconds
  sets        Int     @default(3)
  reps        Int     @default(10) // Lower bound of the prescribed rep range (or the exact count)
  repsMax     Int?    // Upper bound when the coach prescribes a range, e.g. 6-8 → reps=6, repsMax=8
  weight      Float?  // kg or lbs (user preference)
  restSeconds Int?    // Rest between sets
  coachNotes  String? // Per-workout coaching notes
  supersetWithPrevious Boolean @default(false) // Chains this exercise to the one above it into a superset
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  day            Day             @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise       Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  setCompletions SetCompletion[]
  flags          ExerciseFlag[]
  messages       Message[]       @relation("exerciseReference")

  @@unique([dayId, orderIndex])
  @@index([dayId])
  @@index([exerciseId])
  @@map("workout_exercises")
}

// ──────────────────────────────────────
// WORKOUT TRACKING
// ──────────────────────────────────────

model WorkoutCompletion {
  id             String        @id @default(uuid())
  clientId       String
  planId         String        // Denormalized for query performance; validated by trigger
  dayId          String
  status         WorkoutStatus @default(NOT_STARTED)
  startedAt      DateTime?
  completedAt    DateTime?
  completionPct  Float?        // 0.0 to 1.0
  exercisesDone  Int?
  exercisesTotal Int?
  durationSec    Int?
  effortRating   EffortRating?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan     Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  day      Day           @relation(fields: [dayId], references: [id], onDelete: Cascade)
  sets     SetCompletion[]
  flags    ExerciseFlag[]
  messages Message[]     @relation("workoutReference")

  @@unique([clientId, planId, dayId]) // One completion per client per day
  @@index([clientId, status])         // Coach dashboard: find in-progress/missed
  @@index([clientId, completedAt])    // Recent workouts query
  @@map("workout_completions")
}

model SetCompletion {
  id                  String    @id @default(uuid())
  workoutCompletionId String
  workoutExerciseId   String    // References WorkoutExercise, not Exercise
  setNumber           Int       // 1-indexed
  completed           Boolean   @default(false)
  actualWeight        Float?    // Client override
  actualReps          Int?      // Client override
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workoutCompletion WorkoutCompletion @relation(fields: [workoutCompletionId], references: [id], onDelete: Cascade)
  workoutExercise   WorkoutExercise   @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutCompletionId, workoutExerciseId, setNumber]) // Upsert support
  @@index([workoutCompletionId])
  @@map("set_completions")
}

model ExerciseFlag {
  id                  String   @id @default(uuid())
  workoutCompletionId String
  workoutExerciseId   String   // Consistent with SetCompletion
  note                String?  @db.VarChar(200) // 200 char max
  chatMessageId       String?  // If client opened chat about this
  createdAt           DateTime @default(now())

  workoutCompletion WorkoutCompletion @relation(fields: [workoutCompletionId], references: [id], onDelete: Cascade)
  workoutExercise   WorkoutExercise   @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  chatMessage       Message?          @relation(fields: [chatMessageId], references: [id], onDelete: SetNull)

  @@unique([workoutCompletionId, workoutExerciseId]) // One flag per exercise per workout
  @@map("exercise_flags")
}

// ──────────────────────────────────────
// CHECK-INS (North Star Feature)
// ──────────────────────────────────────

model CheckIn {
  id           String        @id @default(uuid())
  coachId      String
  clientId     String
  status       CheckInStatus @default(PENDING)

  // Client response
  effortRating    EffortRating?
  painBlockers    String?       @db.VarChar(500)
  clientFeeling   String?       @db.VarChar(500)
  clientRespondedAt DateTime?

  // Coach response
  coachFeedback   String?
  planAdjustment  Boolean       @default(false)
  coachRespondedAt DateTime?

  // Timestamps
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  coach  CoachProfile  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([clientId])
  @@index([clientId, status])      // Find pending check-ins for client
  @@index([coachId, status])       // Coach dashboard: pending reviews
  @@index([clientId, completedAt]) // Check-in history
  @@map("check_ins")
}

// ──────────────────────────────────────
// MESSAGING
// ──────────────────────────────────────

model Message {
  id                  String    @id @default(uuid())
  senderId            String
  recipientId         String
  content             String
  workoutReferenceId  String?   // Optional: references a WorkoutCompletion
  exerciseReferenceId String?   // Optional: references a WorkoutExercise
  readAt              DateTime?
  createdAt           DateTime  @default(now())

  sender            User               @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient         User               @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  workoutReference  WorkoutCompletion?  @relation("workoutReference", fields: [workoutReferenceId], references: [id], onDelete: SetNull)
  exerciseReference WorkoutExercise?    @relation("exerciseReference", fields: [exerciseReferenceId], references: [id], onDelete: SetNull)
  exerciseFlags     ExerciseFlag[]

  @@index([senderId, recipientId, createdAt])    // Chat thread (sender's view)
  @@index([recipientId, senderId, createdAt])    // Chat thread (recipient's view)
  @@index([recipientId, readAt])                  // Unread count
  @@map("messages")
}

// ──────────────────────────────────────
// PUSH NOTIFICATIONS
// ──────────────────────────────────────

// One row per browser/device that granted notification permission. The
// endpoint is the push service's URL for that device and is globally unique,
// so re-subscribing the same device updates the row instead of stacking.
// Rows are deleted when the push service reports the endpoint is gone
// (404/410) — that is the only reliable "user uninstalled the PWA" signal.
model PushSubscription {
  id         String       @id @default(uuid())
  userId     String
  provider   PushProvider @default(WEB)
  // Web Push: the push-service URL. Expo: the device's push token. Both are
  // globally unique per device, so re-registering updates instead of stacking.
  endpoint   String       @unique
  p256dh     String? // Web Push only: client public key for payload encryption
  auth       String? // Web Push only: client auth secret for payload encryption
  userAgent  String? // Debugging aid: which device this row belongs to
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ──────────────────────────────────────
// PRODUCT FEEDBACK
// ──────────────────────────────────────

// In-app feedback from the account menu's "Send feedback" dialog, reviewed
// on /admin/feedback. Lifecycle: NEW (just submitted) → REVIEWED (owner has
// read it) → RESOLVED (acted on or consciously declined).
model Feedback {
  id       String           @id @default(uuid())
  // SetNull, not Cascade: feedback is the owner's product-research record
  // and should outlive the reporter's account.
  userId   String?
  // Captured at submit time — linked accounts can switch roles later, and
  // "a coach said this" vs "a client said this" is half the signal.
  role     UserRole
  category FeedbackCategory
  message  String           @db.VarChar(2000)
  // Path the dialog was opened from, auto-captured — cheap context that
  // turns "the table is broken" into "the plan editor's table is broken".
  pageUrl  String?          @db.VarChar(1000)
  status   FeedbackStatus   @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt]) // Admin inbox: NEW first, oldest first
  @@index([userId])
  @@map("feedback")
}

// ──────────────────────────────────────
// WAITLIST
// ──────────────────────────────────────

// Lifecycle: PENDING (signed up on the landing page) → INVITED (owner sent a
// beta invite from /admin/waitlist) → JOINED (invite redeemed at coach signup).
// The invite token is single-use — JOINED blocks re-redemption — and
// re-inviting rotates it, which doubles as revocation of the old link.
model WaitlistEntry {
  id          String         @id @default(uuid())
  email       String         @unique
  status      WaitlistStatus @default(PENDING)
  inviteToken String?        @unique
  invitedAt   DateTime?
  joinedAt    DateTime?

  // Where the signup came from. Captured from the landing page URL's utm_*
  // params, falling back to the referring host, so a multi-channel push can
  // be judged per channel instead of as one undifferentiated number.
  source   String?
  medium   String?
  campaign String?
  referrer String?

  // Answered on the confirmation screen, after the email is already saved —
  // asking it before the submit would cost signups, asking it after costs
  // nothing and tells us whether we're attracting coaches or curious lifters.
  clientCount String?

  createdAt DateTime @default(now())

  @@map("waitlist_entries")
}
