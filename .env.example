# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# Auth (NextAuth.js)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Demo access (src/lib/demo.ts). The seeded demo accounts (prisma/seed.ts)
# have public credentials, so demo sign-in is locked on every deployed build
# unless this is explicitly "true" — set it on a preview/staging deployment
# to show the login page's demo buttons there. Unset: demo works in local
# dev only. Inlined at build time, so changing it on Vercel needs a redeploy.
# NEXT_PUBLIC_DEMO_MODE="true"

# Public site origin. Drives canonical URLs, Open Graph images, robots.txt and
# sitemap.xml. Must be the production origin with no trailing slash — a wrong
# value here points every canonical tag at the wrong host.
NEXT_PUBLIC_SITE_URL="https://logbook.fit"

# MCP tooling (.mcp.json reads this from your shell environment)
SUPABASE_ACCESS_TOKEN="sbp_your-personal-access-token"

# Profile photos (Supabase Storage, same project as the database). The
# `avatars` bucket is public-read with a 4MB image-only limit; uploads go
# through /api/account/avatar server-side only. Both from the Supabase
# dashboard: Settings > API. The service-role key bypasses RLS — server
# only, NEVER with a NEXT_PUBLIC_ prefix. With these unset the feature
# no-ops: settings shows the upload but returns "not configured". Either
# key format works: a new secret key (sb_secret_...) or the legacy
# service_role JWT (eyJ...) — both from that same dashboard page.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Waitlist emails (Resend): the signup confirmation and the beta invite.
# Both must be set for emails to send; if unset, waitlist signups still work
# (no confirmation goes out) and admin invites return the link to copy by
# hand instead of emailing it.
RESEND_API_KEY="re_your-resend-api-key"
# Exactly ONE address, as "email@example.com" or "Name <email@example.com>".
# A second address (even inside the <>) makes Resend reject every send with
# a 422 — the admin waitlist page shows a red banner if this is malformed.
WAITLIST_FROM_EMAIL="Logbook.fit <hello@yourdomain.com>"

# Private beta gate. Coach signup is invite-only by default: /signup only
# creates COACH accounts for a valid waitlist invite (sent from
# /admin/waitlist). Set to "true" to let anyone create a coach account —
# needed for local dev, and the switch to flip when the beta opens.
# Client signups are unaffected either way (they use coach invite links).
OPEN_COACH_SIGNUP="true"

# Rate limiting (Upstash Redis). REQUIRED on any serverless deploy: without
# it, limits fall back to a per-instance in-memory store — every lambda gets
# its own budget, so brute-force protection on login/signup/reset is
# effectively off. Create a database at console.upstash.com, or install the
# Vercel Marketplace integration (which injects KV_REST_API_URL/_TOKEN —
# those names work too). Unset in local dev is fine.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Preview/staging migrations. Production deploys always run
# `prisma migrate deploy` (see vercel-build in package.json); preview deploys
# only do when this is "true". Enable it on a staging project whose
# DATABASE_URL points at its own database — leave it off if previews share
# the production database, or previews would apply unreleased migrations.
# MIGRATE_ON_PREVIEW="true"

# Scheduled check-ins. REQUIRED for the weekly check-in promise to hold: the
# nightly Vercel cron (see vercel.json) sends this as a bearer token to
# /api/cron/check-ins, which expires abandoned check-ins and sends the ones
# that are due. Unset, the endpoint refuses every call and check-ins only
# appear when someone happens to open the right page — so a client who stops
# opening the app is never checked on. Vercel sets this for you when you add
# it as an env var; generate with: openssl rand -base64 32
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Web Push (message notifications). Generate a key pair once with:
#   npx web-push generate-vapid-keys
# Both keys must be set for notifications to send; with them unset the whole
# feature no-ops — messages still work, the app just never offers the opt-in
# (GET /api/push/config reports enabled: false). Read at request time, not
# build time, so enabling push on Vercel doesn't need a redeploy.
# VAPID_SUBJECT identifies the sender to push services (mailto: or https URL).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@yourdomain.com"
# Native-app push goes through Expo's push service and needs no keys here.
# Optional: an Expo access token, only checked once "enhanced push security"
# is enabled for the EAS project (expo.dev → project → Credentials).
# EXPO_ACCESS_TOKEN=""

# Waitlist admin access.
#  - ADMIN_EMAILS: comma-separated allowlist that can view /admin/waitlist
#    (must match the email you sign in with).
#  - WAITLIST_ADMIN_TOKEN: secret for scripted CSV export. Send it as a
#    header — never in the URL, so it stays out of access logs:
#    curl -H "Authorization: Bearer $WAITLIST_ADMIN_TOKEN" .../api/waitlist/export
#  - WAITLIST_ADMIN_TOKEN_PREVIOUS (optional): also accepted, for
#    zero-downtime rotation. Move the live token here, set a fresh
#    WAITLIST_ADMIN_TOKEN, migrate your scripts, then unset this.
ADMIN_EMAILS="you@yourdomain.com"
WAITLIST_ADMIN_TOKEN="generate-with-openssl-rand-base64-32"
# WAITLIST_ADMIN_TOKEN_PREVIOUS=""
