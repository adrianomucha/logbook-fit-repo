# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# Auth (NextAuth.js)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# MCP tooling (.mcp.json reads this from your shell environment)
SUPABASE_ACCESS_TOKEN="sbp_your-personal-access-token"

# Waitlist emails (Resend): the signup confirmation and the beta invite.
# Both must be set for emails to send; if unset, waitlist signups still work
# (no confirmation goes out) and admin invites return the link to copy by
# hand instead of emailing it.
RESEND_API_KEY="re_your-resend-api-key"
WAITLIST_FROM_EMAIL="Logbook.fit <hello@yourdomain.com>"

# Private beta gate. Coach signup is invite-only by default: /signup only
# creates COACH accounts for a valid waitlist invite (sent from
# /admin/waitlist). Set to "true" to let anyone create a coach account —
# needed for local dev, and the switch to flip when the beta opens.
# Client signups are unaffected either way (they use coach invite links).
OPEN_COACH_SIGNUP="true"

# Waitlist admin access.
#  - ADMIN_EMAILS: comma-separated allowlist that can view /admin/waitlist
#    (must match the email you sign in with).
#  - WAITLIST_ADMIN_TOKEN: secret for scripted CSV export. Send it as a
#    header — never in the URL, so it stays out of access logs:
#    curl -H "Authorization: Bearer $WAITLIST_ADMIN_TOKEN" .../api/waitlist/export
#  - WAITLIST_ADMIN_TOKEN_PREVIOUS (optional): also accepted, for
#    zero-downtime rotation. Move the live token here, set a fresh
#    WAITLIST_ADMIN_TOKEN, migrate your scripts, then unset this.
ADMIN_EMAILS="you@yourdomain.com"
WAITLIST_ADMIN_TOKEN="generate-with-openssl-rand-base64-32"
# WAITLIST_ADMIN_TOKEN_PREVIOUS=""
