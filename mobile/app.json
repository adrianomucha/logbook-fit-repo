{
  "expo": {
    "name": "Logbook",
    "slug": "logbook-fit",
    "scheme": "logbook",
    "version": "1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "fit.logbook.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fit.logbook.app",
      "adaptiveIcon": {
        "backgroundColor": "#17180F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#c3f910"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Logbook uses your photos when you choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "owner": "logbook-fit",
    "extra": {
      "eas": {
        "projectId": "3ed74137-23ea-424e-be78-7487ad73b9c4"
      }
    }
  }
}
