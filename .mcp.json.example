{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "framer": {
      "type": "sse",
      "url": "https://mcp.unframer.co/sse?id=YOUR_FRAMER_ID&secret=YOUR_FRAMER_SECRET"
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "your-supabase-access-token",
        "SUPABASE_PROJECT_REF": "your-supabase-project-ref"
      }
    }
  }
}
